# ===== Supabase（数据库 + 登录 + 录音存储）=====
# 在 Supabase 控制台 Project Settings → API 里获取
SUPABASE_URL=https://你的项目.supabase.co
SUPABASE_ANON_KEY=你的匿名公钥（客户端用）
SUPABASE_SERVICE_ROLE_KEY=你的服务端密钥（仅服务端使用，切勿暴露到前端）

# ===== 数据库连接串 =====
# Supabase 控制台 → Project Settings → Database → Connection string（用连接池模式）
# postgresql://postgres.xxxx:密码@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://...

# ===== 服务 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ===== 前端构建变量（Vite 会注入）=====
# 与 SUPABASE_URL / SUPABASE_ANON_KEY 相同，VITE_ 前缀是 Vite 读取环境变量的约定
VITE_SUPABASE_URL=https://你的项目.supabase.co
VITE_SUPABASE_ANON_KEY=你的匿名公钥
